- (NSInteger)tableView:(UITableView *)tableView
 numberOfRowsInSection:(NSInteger)section
{
    return [_routes count];
}

- (UITableViewCell *)tableView:(UITableView *)tableView
         cellForRowAtIndexPath:(NSIndexPath *)indexPath
{
    static NSString *identifier =
        @"BusRouteCell";

    UITableViewCell *cell =
        [tableView
            dequeueReusableCellWithIdentifier:
                identifier];

    if (!cell)
    {
        cell =
            [[[UITableViewCell alloc]
                initWithStyle:
                    UITableViewCellStyleSubtitle
                reuseIdentifier:
                    identifier]
                autorelease];

        cell.accessoryType =
            UITableViewCellAccessoryDisclosureIndicator;
    }

    NSDictionary *route =
        [_routes objectAtIndex:indexPath.row];

    cell.textLabel.text =
        [NSString stringWithFormat:
            @"№ %@",
            [route objectForKey:@"number"]];

    cell.detailTextLabel.text =
        [route objectForKey:@"name"];

    return cell;
}

- (void)tableView:(UITableView *)tableView
    didSelectRowAtIndexPath:(NSIndexPath *)indexPath
{
    NSDictionary *route =
        [_routes objectAtIndex:indexPath.row];

    NSString *number =
        [route objectForKey:@"number"];

    if (![number isEqualToString:@"28"])
    {
        UIAlertView *alert =
            [[UIAlertView alloc]
                initWithTitle:
                    [NSString stringWithFormat:
                        @"Маршрут №%@",
                        number]
                message:
                    @"В этом релизе для этого маршрута "
                     "показывается название и маршрут. "
                     "Актуальное время отправления ещё "
                     "не добавлено, чтобы не показывать "
                     "устаревшее расписание."
                delegate:nil
                cancelButtonTitle:@"OK"
                otherButtonTitles:nil];

        [alert show];
        [alert release];

        [tableView deselectRowAtIndexPath:
            indexPath
            animated:YES];

        return;
    }

    [self showRoute28];

    [tableView deselectRowAtIndexPath:
        indexPath
        animated:YES];
}

